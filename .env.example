# ─── GCP Project ────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-project-id
GCP_REGION=asia-south1
GCP_ZONE=asia-south1-a

# ─── GCS Buckets ─────────────────────────────────────────────────────────────
GCS_RAW_BUCKET=your-project-id-fraud-raw
GCS_PROCESSED_BUCKET=your-project-id-fraud-processed
GCS_ARTIFACTS_BUCKET=your-project-id-fraud-artifacts
GCS_AUDIT_BUCKET=your-project-id-fraud-audit

# ─── BigQuery ────────────────────────────────────────────────────────────────
BQ_DATASET=fraud_detection
BQ_LOCATION=asia-south1
BQ_KMS_KEY_NAME=projects/your-project-id/locations/asia-south1/keyRings/fraud-keyring/cryptoKeys/bq-key

# ─── Vertex AI ───────────────────────────────────────────────────────────────
VERTEX_STAGING_BUCKET=gs://your-project-id-fraud-artifacts/staging
VERTEX_PIPELINE_ROOT=gs://your-project-id-fraud-artifacts/pipelines
VERTEX_EXPERIMENT_NAME=fraud-detection-baseline
VERTEX_FEATURESTORE_ID=fraud_feature_store

# ─── Service Accounts ────────────────────────────────────────────────────────
TRAINING_SA=training-sa@your-project-id.iam.gserviceaccount.com
SERVING_SA=serving-sa@your-project-id.iam.gserviceaccount.com
PIPELINE_SA=pipeline-sa@your-project-id.iam.gserviceaccount.com
MONITORING_SA=monitoring-sa@your-project-id.iam.gserviceaccount.com

# ─── Secret Manager ──────────────────────────────────────────────────────────
KAGGLE_SECRET_NAME=kaggle-credentials
BQ_CMEK_SECRET_NAME=bq-cmek-key-name

# ─── Model Training ──────────────────────────────────────────────────────────
MODEL_MAX_ITER=1000
MODEL_RANDOM_STATE=42
MODEL_TEST_SIZE=0.2
MODEL_CV_FOLDS=5

# ─── Artifact Registry ───────────────────────────────────────────────────────
AR_REPOSITORY=fraud-detection-repo
AR_REGION=asia-south1

# ─── Notifications ───────────────────────────────────────────────────────────
ALERT_EMAIL=your-email@example.com
