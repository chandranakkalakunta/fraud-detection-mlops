# ─── GCP Project ────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-project-id
GCP_REGION=asia-south1
GCP_ZONE=asia-south1-a

# ─── GCS Buckets ─────────────────────────────────────────────────────────────
GCS_RAW_BUCKET=your-project-id-fraud-raw
GCS_PROCESSED_BUCKET=your-project-id-fraud-processed
GCS_ARTIFACTS_BUCKET=your-project-id-fraud-artifacts
GCS_AUDIT_BUCKET=your-project-id-fraud-audit

# ─── BigQuery ────────────────────────────────────────────────────────────────
BQ_DATASET=fraud_detection
BQ_LOCATION=asia-south1
BQ_KMS_KEY_NAME=projects/your-project-id/locations/asia-south1/keyRings/fraud-keyring/cryptoKeys/bq-key

# ─── Vertex AI ───────────────────────────────────────────────────────────────
VERTEX_STAGING_BUCKET=gs://your-project-id-fraud-artifacts/staging
VERTEX_PIPELINE_ROOT=gs://your-project-id-fraud-artifacts/pipelines
VERTEX_EXPERIMENT_NAME=fraud-detection-baseline
VERTEX_FEATURESTORE_ID=fraud_feature_store

# ─── Service Accounts ────────────────────────────────────────────────────────
TRAINING_SA=training-sa@your-project-id.iam.gserviceaccount.com
SERVING_SA=serving-sa@your-project-id.iam.gserviceaccount.com
PIPELINE_SA=pipeline-sa@your-project-id.iam.gserviceaccount.com
MONITORING_SA=monitoring-sa@your-project-id.iam.gserviceaccount.com

# ─── Secret Manager ──────────────────────────────────────────────────────────
KAGGLE_SECRET_NAME=kaggle-credentials
BQ_CMEK_SECRET_NAME=bq-cmek-key-name

# ─── Model Training ──────────────────────────────────────────────────────────
MODEL_MAX_ITER=1000
MODEL_RANDOM_STATE=42
MODEL_TEST_SIZE=0.2
MODEL_CV_FOLDS=5

# ─── Artifact Registry ───────────────────────────────────────────────────────
AR_REPOSITORY=fraud-detection-repo
AR_REGION=asia-south1

# ─── Feature Engineering ─────────────────────────────────────────────────────
FEATURE_MISSING_THRESHOLD=0.05

# ─── XGBoost ─────────────────────────────────────────────────────────────────
XGB_N_ESTIMATORS=500
XGB_MAX_DEPTH=6
XGB_LEARNING_RATE=0.05
XGB_SCALE_POS_WEIGHT=27

# ─── LightGBM ────────────────────────────────────────────────────────────────
LGB_NUM_LEAVES=64
LGB_LEARNING_RATE=0.05
LGB_N_ESTIMATORS=500

# ─── Explainability ──────────────────────────────────────────────────────────
SHAP_TOP_N_FEATURES=20

# ─── Notifications ───────────────────────────────────────────────────────────
ALERT_EMAIL=your-email@example.com

# ─── Serving (Phase 4) ───────────────────────────────────────────────────────
VERTEX_ENDPOINT_DISPLAY_NAME=fraud-detection-endpoint
VERTEX_ENDPOINT_RESOURCE_NAME=                        # filled after first deploy
VERTEX_MODEL_RESOURCE_NAME=projects/YOUR_PROJECT_NUMBER/locations/asia-south1/models/MODEL_ID@1
SERVING_CALIBRATED_THRESHOLD=0.2458
SERVING_TRANSFORMER_GCS_URI=gs://your-project-id-fraud-artifacts/transformers/feature_engineer.joblib
PREDICTION_LOG_BQ_TABLE=prediction_logs
API_KEY_SECRET_NAME=fraud-api-key
CLOUD_RUN_SERVICE_NAME=fraud-detection-api
STREAMLIT_SERVICE_NAME=fraud-detection-streamlit
CLOUD_RUN_API_URL=                                    # filled after Cloud Run deploy

# ─── Drift Monitoring (Phase 4) ──────────────────────────────────────────────
DRIFT_LOG_BQ_TABLE=drift_logs
FEATURE_DRIFT_ALERT_POLICY=feature-drift-alert
PERFORMANCE_DRIFT_ALERT_POLICY=performance-drift-alert
